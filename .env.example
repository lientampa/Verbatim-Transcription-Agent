# Google Gemini API Key (Bắt buộc)
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Model Gemini sử dụng (Mặc định: gemini-2.5-flash, có thể đổi thành gemini-3.7-flash)
GEMINI_MODEL=gemini-2.5-flash

# Disable automatic model switching for controlled comparisons.
MODEL_FALLBACK_ENABLED=true

# Inspect tails longer than two minutes; allow normal pauses/timestamp estimates.
COVERAGE_TAIL_GAP_THRESHOLD_SEC=120
# Thirty seconds of non-silent audio warrants review (not proof of speech).
COVERAGE_ACTIVE_TAIL_MIN_SEC=30
COVERAGE_SILENCE_THRESHOLD_DB=-40
# Rebuild from the unconfirmed start at half the physical duration.
COVERAGE_SHRINK_FACTOR=0.5

# Cấu hình retry cho API call
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=2

# Cấu hình timeout (giây)
TIMEOUT_SECONDS=300
