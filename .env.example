# Google Gemini API Key (Bắt buộc)
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Model Gemini sử dụng (Mặc định: gemini-3.8-flash, có thể đổi thành gemini-3.7-flash)
GEMINI_MODEL=gemini-3.8-flash

# Disable automatic model switching for controlled comparisons.
MODEL_FALLBACK_ENABLED=true

# Inspect tails longer than two minutes; allow normal pauses/timestamp estimates.
COVERAGE_TAIL_GAP_THRESHOLD_SEC=120
# Skip activity analysis only when the tail also occupies at most 10% of the slice.
COVERAGE_SMALL_GAP_MAX_RATIO=0.1
# Thirty seconds of non-silent audio warrants review (not proof of speech).
COVERAGE_ACTIVE_TAIL_MIN_SEC=30
COVERAGE_SILENCE_THRESHOLD_DB=-40
# Rebuild from the unconfirmed start at half the physical duration.
COVERAGE_SHRINK_FACTOR=0.5

# Runtime-only, per-actual-model learning. Three strong passes allow 10% growth.
COVERAGE_MAX_GENERATIONS=4
COVERAGE_GROWTH_FACTOR=1.1
COVERAGE_GROWTH_PASSES=3
COVERAGE_GROWTH_HEADROOM_SEC=30
UNKNOWN_MODEL_DURATION_SEC=300

# SPEED_FIRST, WAIT_FIRST, MODEL_LOCK; disabled fallback also locks.
# Legacy PROVIDER_FALLBACK_POLICY is read only when PROVIDER_RETRY_POLICY is absent.
PROVIDER_RETRY_POLICY=SPEED_FIRST
# Authoritative provider delays above this ceiling cause fallback/fail, never early retry.
MAX_PROVIDER_WAIT_SECONDS=5
RETRY_MAX_DELAY_SECONDS=8
RETRY_BACKOFF_MULTIPLIER=2
MAX_TRANSIENT_RETRIES_PER_MODEL=2
# Preferred order is enforced centrally and filtered through models.list at startup.
# FALLBACK_MODELS is retained for configuration compatibility; it cannot override that order.
FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Cấu hình retry cho API call
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=1

# Cấu hình timeout (giây)
TIMEOUT_SECONDS=300

# Require absolute HH:MM:SS and a human-readable speaker label before confirmation.
STRICT_SPEAKER_FORMAT=true

# Fresh blocks prefer the largest budget-safe duration; retries shrink locally.
# LEARNED retains the previous conservative Stage 4.3 policy if explicitly selected.
NEXT_TARGET_POLICY=MAX_FIRST
MAX_PROBE_FAILURE_THRESHOLD=3
MAX_PROBE_COOLDOWN_SUCCESSES=2

# Job-scoped output circuit: active tail >=75%, or impossible hour-scale timestamps.
# Two severe responses without an accepted block open the circuit for that model.
SEVERE_COVERAGE_RATIO=0.75
MODEL_HEALTH_STRIKE_LIMIT=2

# Hard product exclusion applied to requested models, fallbacks, profiles and SDK calls.
ALLOW_LITE_MODELS=false

# Optional independent size rebuild limit (2 = two retries after initial slice).
# When absent, preserves legacy allowance: VALIDATOR_MAX_RETRIES - 1.
# SIZE_RETRY_LIMIT=2
# Optional generation cap, clamped to actual model's discovered output_token_limit.
# Absent means provider default; MODEL_MAX_OUTPUT_TOKENS remains DABB planning only.
# GEMINI_MAX_OUTPUT_TOKENS=

# Stage 6 render-only timing. Schema has start timestamps, no model-observed ends.
SRT_END_POLICY=NEXT_START
SRT_MIN_DURATION=0.1
SRT_ESTIMATED_DURATION=4
