# Google Gemini API Key (Bắt buộc)
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Model Gemini sử dụng (Mặc định: gemini-2.5-flash, có thể đổi thành gemini-3.7-flash)
GEMINI_MODEL=gemini-2.5-flash

# Disable automatic model switching for controlled comparisons.
MODEL_FALLBACK_ENABLED=true

# Inspect tails longer than two minutes; allow normal pauses/timestamp estimates.
COVERAGE_TAIL_GAP_THRESHOLD_SEC=120
# Skip activity analysis only when the tail also occupies at most 10% of the slice.
COVERAGE_SMALL_GAP_MAX_RATIO=0.1
# Thirty seconds of non-silent audio warrants review (not proof of speech).
COVERAGE_ACTIVE_TAIL_MIN_SEC=30
COVERAGE_SILENCE_THRESHOLD_DB=-40
# Rebuild from the unconfirmed start at half the physical duration.
COVERAGE_SHRINK_FACTOR=0.5

# Runtime-only, per-actual-model learning. Three strong passes allow 10% growth.
COVERAGE_MAX_GENERATIONS=4
COVERAGE_GROWTH_FACTOR=1.1
COVERAGE_GROWTH_PASSES=3
COVERAGE_GROWTH_HEADROOM_SEC=30
UNKNOWN_MODEL_DURATION_SEC=300

# PREFER_WAIT, PREFER_FALLBACK, or LOCK_MODEL. Disabled fallback also locks.
PROVIDER_FALLBACK_POLICY=PREFER_WAIT
# Per-wait ceiling (0..60 seconds); longer RetryInfo advances/fails without waiting.
MAX_PROVIDER_BACKOFF_SECONDS=30
FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.5-flash

# Cấu hình retry cho API call
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=2

# Cấu hình timeout (giây)
TIMEOUT_SECONDS=300
