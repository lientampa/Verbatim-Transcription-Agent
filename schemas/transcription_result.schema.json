{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TranscriptionResult",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "session_id",
    "block_id",
    "first_source_index",
    "last_source_index",
    "status",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "block_id": {
      "type": "string",
      "minLength": 1
    },
    "first_source_index": {
      "type": "integer",
      "minimum": 1
    },
    "last_source_index": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["CONFIRMED", "PROCESSING", "FAILED"]
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_index",
          "text"
        ],
        "properties": {
          "source_index": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp": {
            "type": ["string", "null"]
          },
          "speaker": {
            "type": ["string", "null"]
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
