{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vietnamese golden reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "language",
    "source_mode",
    "source",
    "review",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "language": {
      "const": "vi"
    },
    "source_mode": {
      "const": "AUDIO"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint_sha256",
        "duration_seconds"
      ],
      "properties": {
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "audio_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNREVIEWED",
            "PENDING_MANUAL_REVIEW",
            "HUMAN_REVIEWED",
            "DOUBLE_REVIEWED",
            "SYNTHETIC_TEST",
            "EXAMPLE_ONLY"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_seconds",
          "speaker",
          "text",
          "uncertain"
        ],
        "properties": {
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "uncertain": {
            "type": "boolean"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "text"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "filler",
                    "repetition",
                    "false_start"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "proper_names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "block_id": {
            "type": "string"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_seconds",
          "end_seconds",
          "type"
        ],
        "properties": {
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "type": {
            "enum": [
              "silence",
              "noise",
              "music",
              "non_speech",
              "overlap"
            ]
          },
          "authoritative": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
